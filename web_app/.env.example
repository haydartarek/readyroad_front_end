# Server-side backend connection and browser-visible API origin
BACKEND_URL=http://localhost:8890/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8890

# Public frontend origins used by metadata and OAuth routes
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client identifier. The client secret belongs to the backend only.
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form mail delivery
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_app_password
CONTACT_TO=replace_with_contact_recipient
